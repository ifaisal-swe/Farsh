# The site and its MCP server (https://DOMAIN/mcp)
DOMAIN=farsh.ifaisal.net
ADMIN_EMAIL=you@example.com
MAX_TENANTS=10
TENANT_MEMORY_MB=256
# at least MAX_TENANTS x (TENANT_MEMORY_MB + 100 MB) + 500 MB
APP_MEMORY=4g
PG_MEMORY=1g
# public key (age1...) that encrypts backups; keep the private key OFF this server
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/var/backups/forsah
BACKUP_KEEP_DAYS=14
# optional rclone target, for example remote:bucket/path
BACKUP_REMOTE=
