# Copy to .env for local use (never commit .env). On Railway, set these as service Variables instead.
# Values here override keys saved in the Settings UI. Every key is optional unless marked REQUIRED.
# The application is PAPER TRADING ONLY: no variable here can enable real brokerage orders.

# ---------------------------------------------------------------- server / storage
# NODE_ENV=production makes the server listen on 0.0.0.0 and REQUIRES a dashboard password.
# NODE_ENV=production
# PORT is injected by Railway. Locally the default is 8787.
# PORT=8787
# Where the SQLite database lives. On Railway point it at the volume, e.g. /data/trading.db
# (if unset on Railway, <RAILWAY_VOLUME_MOUNT_PATH>/trading.db is used automatically).
# DATABASE_PATH=/data/trading.db
# Public address of the dashboard (used for allowed Host/Origin checks). Railway's own
# *.up.railway.app domain is picked up automatically from RAILWAY_PUBLIC_DOMAIN.
# APP_BASE_URL=https://your-app.up.railway.app
# Extra allowed host names (custom domains), comma separated.
# ALLOWED_HOSTS=trading.example.com

# ---------------------------------------------------------------- dashboard login (REQUIRED in production)
# Either a plain password (min. 12 characters, hashed in memory at start) ...
# DASHBOARD_PASSWORD=
# ... or, better, a scrypt hash created with:  npm run hash-password
# DASHBOARD_PASSWORD_HASH=
# Optional session lifetimes
# SESSION_IDLE_HOURS=12
# SESSION_MAX_DAYS=7

# ---------------------------------------------------------------- encryption of keys saved in the UI
# 64 hex characters. If empty, a random key is created next to the database (data/master.key or /data/master.key).
TERMINAL_MASTER_KEY=

# ---------------------------------------------------------------- AI providers (both supported)
# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ---------------------------------------------------------------- market data (read-only)
# Alpaca (https://app.alpaca.markets -> Paper account -> API keys). No orders are ever sent.
# ALPACA_API_KEY / ALPACA_API_SECRET are accepted as aliases.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Optional Tiingo token for extended-hours / overnight reference prices
TIINGO_API_KEY=
# SEC EDGAR fair-access policy: "Your Name you@example.com" (leave empty to disable EDGAR news)
SEC_USER_AGENT=

# ---------------------------------------------------------------- Telegram
TELEGRAM_BOT_TOKEN=
# Your private chat id (= your user id) and/or a group id (negative). Merged with Settings → Telegram.
# TELEGRAM_CHAT_ID=123456789
# User ids allowed to run commands that change state (comma separated). A private chat id is added automatically.
# TELEGRAM_ADMIN_USER_IDS=123456789
# Force the bot on/off regardless of the Settings switch
# TELEGRAM_ENABLED=true

# ---------------------------------------------------------------- operations
# Seconds to finish in-flight work on shutdown (also set RAILWAY_DEPLOYMENT_DRAINING_SECONDS on Railway)
# SHUTDOWN_TIMEOUT_SEC=25
# Replacing a database that already holds trades with an imported one requires this explicit flag:
# DB_IMPORT_CONFIRM=overwrite
