{
  "name": "farsh",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Forsah — AI-powered PAPER trading terminal: real market data (Alpaca, Tiingo), DeepSeek + Gemini analysis, deterministic risk & simulated execution, Telegram companion. Never sends real orders.",
  "main": "server/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "saas": "node --disable-warning=ExperimentalWarning -e \"process.env.SAAS_MODE='1';require('./server/index.js')\"",
    "services": "node scripts/services.js",
    "web:build": "npm --prefix web ci && npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "demo": "node --disable-warning=ExperimentalWarning server/index.js --demo",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 --test-timeout=60000 \"test/*.test.js\"",
    "replay": "node --disable-warning=ExperimentalWarning scripts/replay.js",
    "hash-password": "node scripts/hash-password.js",
    "preflight": "node --disable-warning=ExperimentalWarning scripts/preflight.js",
    "predeploy": "npm test && npm run preflight -- --production"
  },
  "dependencies": {
    "@mastra/core": "1.85.0",
    "@mastra/mcp": "2.10.0",
    "better-auth": "1.7.27",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "lightweight-charts": "^5.3.0",
    "pg": "^8.23.1",
    "ws": "^8.23.0",
    "zod": "4.6.7"
  }
}
